<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:name=".MpesaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/app_logo"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/app_logo_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.MPesaAnalyzer"
        tools:targetApi="35">

        <meta-data
            android:name="android.max_aspect"
            android:value="2.4" />

        <activity
            android:name=".splash.SetupActivity"
            android:exported="false"
            android:theme="@style/Theme.MPesaAnalyzer_NoAction" />

        <activity
            android:name=".splash.Splash"
            android:exported="true"
            android:theme="@style/Theme.MPesaAnalyzer_NoAction">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".auth.TokenAuthActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MPesaAnalyzer_NoAction" />

        <!-- Force QR scanner (ZXing CaptureActivity) to portrait -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            tools:replace="screenOrientation" />

        <activity
            android:name=".LockActivity"
            android:exported="false"
            android:theme="@style/Theme.MPesaAnalyzer" />
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.MPesaAnalyzer" />

        <activity
            android:name=".chat.ChatActivity"
            android:exported="false"
            android:label="Ask My M-Pesa"
            android:theme="@style/Theme.MPesaAnalyzer_NoAction" />
            
        <service
            android:name=".services.UploadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".receivers.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receivers.NotificationActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.niccher.mpesa_analyzer_app.ACTION_CHANGE_CATEGORY" />
                <action android:name="com.niccher.mpesa_analyzer_app.ACTION_ADD_NOTE" />
                <action android:name="com.niccher.mpesa_analyzer_app.ACTION_SPLIT_BILL" />
            </intent-filter>
        </receiver>

        <!-- Homescreen Glance Widget -->
        <receiver
            android:name=".widget.MpesaGlanceWidget"
            android:exported="true"
            android:label="M-Pesa Live Glance">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.niccher.mpesa_analyzer_app.ACTION_SYNC_WIDGET" />
                <action android:name="MPESA_UPLOAD_COMPLETE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mpesa_widget_info" />
        </receiver>
    </application>

</manifest>