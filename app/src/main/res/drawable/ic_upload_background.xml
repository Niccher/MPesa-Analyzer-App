<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/colorPrimaryDark" />

            <padding
                android:left="@dimen/_1sdp"
                android:top="@dimen/_1sdp"
                android:bottom="@dimen/_1sdp"
                android:right="@dimen/_1sdp" />

        </shape>
    </item>
    <!-- Background -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/colorPrimary" />
            <size
                android:height="@dimen/_50sdp"
                android:width="@dimen/_50sdp" />
        </shape>
    </item>

    <item android:drawable="@drawable/ic_add"
        android:bottom="@dimen/_6sdp"
        android:left="@dimen/_6sdp"
        android:right="@dimen/_6sdp"
        android:top="@dimen/_6sdp"/>
</layer-list>