<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/chat_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/brand_primary"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:title="Ask My M-Pesa"
        app:subtitle="AI Financial Advisor (Qwen 2.5)" />

    <!-- Suggestion Chips Row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card_light"
        android:paddingVertical="8dp"
        android:paddingHorizontal="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chips_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_spending_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_rounded_label"
                android:backgroundTint="@color/bg_primary_faint"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="📊 Spending this month?"
                android:textColor="@color/brand_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_top_payees"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_rounded_label"
                android:backgroundTint="@color/bg_primary_faint"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="👥 Top 5 payees?"
                android:textColor="@color/brand_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_fuliza_fees"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_rounded_label"
                android:backgroundTint="@color/bg_primary_faint"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="💳 Fuliza fees this year?"
                android:textColor="@color/brand_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_afford_purchase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_rounded_label"
                android:backgroundTint="@color/bg_primary_faint"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="💡 Can I afford KES 15,000?"
                android:textColor="@color/brand_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_sheng_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_label"
                android:backgroundTint="@color/bg_primary_faint"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="🇰🇪 Nipe tip ya ku-save"
                android:textColor="@color/brand_primary"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Chat Messages RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="8dp" />

    <!-- Thinking / Loading Indicator -->
    <LinearLayout
        android:id="@+id/layout_thinking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card_light"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/brand_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="M-Pesa Advisor is analyzing your finances…"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Bottom Message Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card_light"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/et_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_metric_card"
            android:hint="Ask about your spending in English or Sheng…"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_send"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/brand_primary"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:text="➤"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
