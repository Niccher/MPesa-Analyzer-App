<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_primary_dark"
    android:fitsSystemWindows="true"
    tools:context=".splash.Splash">

    <!-- Centered Brand Container -->
    <LinearLayout
        android:id="@+id/layout_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/txt_splash_version"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <!-- Master Brand Shield Logo -->
        <ImageView
            android:id="@+id/img_splash_logo"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:contentDescription="M-Pesa Analyzer Logo"
            android:src="@mipmap/app_logo" />

        <!-- App Name -->
        <TextView
            android:id="@+id/txt_splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.02"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Tagline -->
        <TextView
            android:id="@+id/txt_splash_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Smart SMS Financial Insights"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <!-- Indeterminate Loading Indicator -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/splash_progress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="32dp"
            android:indeterminate="true"
            app:indicatorColor="@color/brand_primary"
            app:indicatorSize="32dp"
            app:trackColor="@color/bg_surface_dark"
            app:trackThickness="3dp" />

    </LinearLayout>

    <!-- Version and Security Badge -->
    <TextView
        android:id="@+id/txt_splash_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:text="v1.0.0 • Secure &amp; Offline-First"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>