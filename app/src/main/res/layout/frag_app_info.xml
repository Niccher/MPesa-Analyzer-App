<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mainlinerlayoutcolor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Application Details"
            android:textColor="@color/signupsignintextcolor"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:paddingStart="4dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MyMpesaAnalyser"
                    android:textColor="@color/primarytext"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Version 1.0.0"
                    android:textColor="@color/secondarytext"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="What it does"
                    android:textColor="@color/primarytext"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="24dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MyMpesaAnalyser acts as your personal financial assistant. It automatically categorizes and visualizes your M-PESA SMS transactions, transforming raw text messages into rich, interactive graphs, deep search functionality, and simple financial summaries so you can track cash-flow trends clearly."
                    android:textColor="@color/secondarytext"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="How it does it"
                    android:textColor="@color/primarytext"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="24dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="The application securely reads M-PESA transactions entirely on-device. By utilizing rigorous regex matching strategies against your SMS inbox format, it extracts exact monetary values, timestamps, and interaction classifications (Sent, Received, Paybill, Withdrawals). The parsing strictly respects your privacy—information remains sandboxed on your device behind robust Biometric Lock safeguards without arbitrary third-party cloud data uploads."
                    android:textColor="@color/secondarytext"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
