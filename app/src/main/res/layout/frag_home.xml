<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B1B8ED">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_margin="@dimen/_20sdp"
            android:background="#B1B8ED"
            app:cardCornerRadius="@dimen/_40sdp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#B1B8ED"
                android:orientation="vertical"
                android:paddingBottom="@dimen/_20sdp">

                <Button
                    android:id="@+id/home_req_perm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/marign_23"
                    android:layout_marginTop="@dimen/marign_16"
                    android:layout_marginRight="@dimen/marign_23"
                    android:background="@drawable/rectsignin"
                    android:text="Request Permision"
                    android:textAllCaps="false"
                    android:textColor="@color/thirdtext"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/home_fetch_sync"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/marign_23"
                    android:layout_marginTop="@dimen/marign_16"
                    android:layout_marginRight="@dimen/marign_23"
                    android:background="@drawable/rectsignin"
                    android:text="Fetch and Sync"
                    android:textAllCaps="false"
                    android:textColor="@color/thirdtext"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/home_last_upload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="right"
                    android:layout_marginStart="@dimen/marign_8"
                    android:layout_marginLeft="@dimen/marign_8"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:layout_marginEnd="@dimen/marign_10"
                    android:layout_marginRight="@dimen/marign_10"
                    android:text="@string/forgot_password"
                    android:textColor="@color/secondarytext"
                    android:textSize="@dimen/textsize_18" />

                <ProgressBar
                    android:id="@+id/home_upload_state"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_23sdp"
                    android:layout_marginRight="@dimen/_23sdp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/black"
                    android:max="100" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </RelativeLayout>

</FrameLayout>