<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/_4sdp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/part_spinner_frame"
        android:layout_width="@dimen/_160sdp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_8sdp">

        <ImageView
            android:id="@+id/part_spinner_img"
            android:layout_width="@dimen/_48sdp"
            android:layout_height="@dimen/_24sdp"
            android:src="@mipmap/summ_money_all"
            app:layout_constraintEnd_toStartOf="@id/part_spinner_txt"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/part_spinner_txt"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:gravity="start"
            android:text="@string/app_name"
            android:textSize="@dimen/_12sdp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/part_spinner_img"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/part_spinner_img" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</RelativeLayout>