<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    tools:viewBindingIgnore="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_error"
                android:tint="@color/bg_red" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/str_errors_and_failures_52"
                android:textColor="@color/bg_red"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_expand_errors"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_drop_down"
                android:tint="@color/color_text_secondary_legacy" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="20dp"
            android:background="@color/color_ui_divider" />

        <LinearLayout
            android:id="@+id/ll_errors_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="visible">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:orientation="horizontal">

                <!-- item_error_all -->
                <LinearLayout
                    android:id="@+id/item_error_all"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="8dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_metric_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/iv_metric_icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@mipmap/summ_money_wrong_pin"
                        android:contentDescription="@string/str_all_errors_54" />

                    <TextView
                        android:id="@+id/tv_metric_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/str_0_27"
                        android:textColor="@color/semantic_danger"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_metric_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/str_all_errors_54"
                        android:textColor="@color/color_text_primary_legacy"
                        android:textSize="11sp"
                        android:textAlignment="center" />
                </LinearLayout>

                <!-- item_error_pin -->
                <LinearLayout
                    android:id="@+id/item_error_pin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="8dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_metric_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/iv_metric_icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@mipmap/summ_money_wrong_pin"
                        android:contentDescription="@string/str_wrong_pin_45" />

                    <TextView
                        android:id="@+id/tv_metric_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/str_0_27"
                        android:textColor="@color/semantic_danger"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_metric_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/str_wrong_pin_45"
                        android:textColor="@color/color_text_primary_legacy"
                        android:textSize="11sp"
                        android:textAlignment="center" />
                </LinearLayout>

                <!-- item_error_less -->
                <LinearLayout
                    android:id="@+id/item_error_less"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="8dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_metric_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/iv_metric_icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@mipmap/summ_money_wrong_pin"
                        android:contentDescription="@string/str_insufficient_72" />

                    <TextView
                        android:id="@+id/tv_metric_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/str_0_27"
                        android:textColor="@color/semantic_danger"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_metric_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/str_insufficient_72"
                        android:textColor="@color/color_text_primary_legacy"
                        android:textSize="11sp"
                        android:textAlignment="center" />
                </LinearLayout>

                <!-- item_error_receiver -->
                <LinearLayout
                    android:id="@+id/item_error_receiver"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="8dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_metric_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/iv_metric_icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@mipmap/summ_money_wrong_pin"
                        android:contentDescription="@string/str_bad_receiver_38" />

                    <TextView
                        android:id="@+id/tv_metric_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/str_0_27"
                        android:textColor="@color/semantic_danger"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_metric_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/str_bad_receiver_38"
                        android:textColor="@color/color_text_primary_legacy"
                        android:textSize="11sp"
                        android:textAlignment="center" />
                </LinearLayout>

                <!-- item_error_org -->
                <LinearLayout
                    android:id="@+id/item_error_org"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="8dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_metric_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/iv_metric_icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@mipmap/summ_money_wrong_pin"
                        android:contentDescription="@string/str_bad_org_47" />

                    <TextView
                        android:id="@+id/tv_metric_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/str_0_27"
                        android:textColor="@color/semantic_danger"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_metric_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/str_bad_org_47"
                        android:textColor="@color/color_text_primary_legacy"
                        android:textSize="11sp"
                        android:textAlignment="center" />
                </LinearLayout>

                <!-- item_error_failed -->
                <LinearLayout
                    android:id="@+id/item_error_failed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="8dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_metric_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/iv_metric_icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@mipmap/summ_money_wrong_pin"
                        android:contentDescription="@string/str_failed_60" />

                    <TextView
                        android:id="@+id/tv_metric_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/str_0_27"
                        android:textColor="@color/semantic_danger"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_metric_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/str_failed_60"
                        android:textColor="@color/color_text_primary_legacy"
                        android:textSize="11sp"
                        android:textAlignment="center" />
                </LinearLayout>
            </GridLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>