                        android:textColor="@color/primarytext"
                        android:textSize="11sp"
                        android:textAlignment="center" />
                </LinearLayout>

                <!-- item_gen_wrong_pin -->
                <LinearLayout
                    android:id="@+id/item_gen_wrong_pin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="8dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_metric_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/iv_metric_icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@mipmap/summ_money_wrong_pin"
                        android:contentDescription="@string/str_wrong_pin_45" />

                    <TextView
                        android:id="@+id/tv_metric_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/str_0_27"
                        android:textColor="@color/bg_green"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_metric_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/str_wrong_pin_45"
                        android:textColor="@color/primarytext"
                        android:textSize="11sp"
                        android:textAlignment="center" />
                </LinearLayout>

                <!-- item_gen_unknown -->
                <LinearLayout
                    android:id="@+id/item_gen_unknown"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="8dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_metric_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/iv_metric_icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@mipmap/summ_money_unknown"
                        android:contentDescription="@string/str_unknown_34" />

                    <TextView
                        android:id="@+id/tv_metric_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/str_0_27"
                        android:textColor="@color/bg_green"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_metric_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/str_unknown_34"
                        android:textColor="@color/primarytext"
                        android:textSize="11sp"
                        android:textAlignment="center" />
                </LinearLayout>
            </GridLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>