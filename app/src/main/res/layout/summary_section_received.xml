<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    tools:viewBindingIgnore="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_received"
                android:tint="@color/bg_green" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/str_received_breakdown_28"
                android:textColor="@color/semantic_success"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_expand_received"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_drop_down"
                android:tint="@color/secondarytext" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="20dp"
            android:background="@color/linecolor" />

        <LinearLayout
            android:id="@+id/ll_received_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="visible">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:orientation="horizontal">

                <!-- item_rec_all -->
                <LinearLayout
                    android:id="@+id/item_rec_all"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="8dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_metric_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/iv_metric_icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@mipmap/summ_money_all"
                        android:contentDescription="@string/str_all_received_57" />

                    <TextView
                        android:id="@+id/tv_metric_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/str_0_27"
                        android:textColor="@color/semantic_success"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_metric_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/str_all_received_57"
                        android:textColor="@color/primarytext"
                        android:textSize="11sp"
                        android:textAlignment="center" />
                </LinearLayout>

                <!-- item_rec_mpesa -->
                <LinearLayout
                    android:id="@+id/item_rec_mpesa"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="8dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_metric_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/iv_metric_icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@mipmap/summ_money_balance"
                        android:contentDescription="@string/str_from_mpesa_33" />

                    <TextView
                        android:id="@+id/tv_metric_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/str_0_27"
                        android:textColor="@color/semantic_success"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_metric_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/str_from_mpesa_33"
                        android:textColor="@color/primarytext"
                        android:textSize="11sp"
                        android:textAlignment="center" />
                </LinearLayout>

                <!-- item_rec_mshwari -->
                <LinearLayout
                    android:id="@+id/item_rec_mshwari"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="8dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_metric_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/iv_metric_icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@mipmap/summ_money_fuliza"
                        android:contentDescription="@string/str_from_mshwari_62" />

                    <TextView
                        android:id="@+id/tv_metric_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/str_0_27"
                        android:textColor="@color/semantic_success"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_metric_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/str_from_mshwari_62"
                        android:textColor="@color/primarytext"
                        android:textSize="11sp"
                        android:textAlignment="center" />
                </LinearLayout>

                <!-- item_rec_ncba -->
                <LinearLayout
                    android:id="@+id/item_rec_ncba"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="8dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_metric_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/iv_metric_icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@mipmap/summ_money_received"
                        android:contentDescription="@string/str_from_ncba_71" />

                    <TextView
                        android:id="@+id/tv_metric_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/str_0_27"
                        android:textColor="@color/semantic_success"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_metric_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/str_from_ncba_71"
                        android:textColor="@color/primarytext"
                        android:textSize="11sp"
                        android:textAlignment="center" />
                </LinearLayout>

                <!-- item_rec_im -->
                <LinearLayout
                    android:id="@+id/item_rec_im"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="8dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_metric_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/iv_metric_icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@mipmap/summ_money_sent"
                        android:contentDescription="@string/str_from_i_amp_m_70" />

                    <TextView
                        android:id="@+id/tv_metric_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/str_0_27"
                        android:textColor="@color/semantic_success"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_metric_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/str_from_i_amp_m_70"
                        android:textColor="@color/primarytext"
                        android:textSize="11sp"
                        android:textAlignment="center" />
                </LinearLayout>

                <!-- item_rec_reversal -->
                <LinearLayout
                    android:id="@+id/item_rec_reversal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="8dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_metric_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/iv_metric_icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@mipmap/summ_money_withdraw"
                        android:contentDescription="@string/str_reversal_63" />

                    <TextView
                        android:id="@+id/tv_metric_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/str_0_27"
                        android:textColor="@color/semantic_success"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_metric_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/str_reversal_63"
                        android:textColor="@color/primarytext"
                        android:textSize="11sp"
                        android:textAlignment="center" />
                </LinearLayout>

                <!-- item_rec_kcb -->
                <LinearLayout
                    android:id="@+id/item_rec_kcb"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="8dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_metric_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/iv_metric_icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@mipmap/summ_money_received"
                        android:contentDescription="@string/str_from_kcb_44" />

                    <TextView
                        android:id="@+id/tv_metric_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/str_0_27"
                        android:textColor="@color/semantic_success"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_metric_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/str_from_kcb_44"
                        android:textColor="@color/primarytext"
                        android:textSize="11sp"
                        android:textAlignment="center" />
                </LinearLayout>

            </GridLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>